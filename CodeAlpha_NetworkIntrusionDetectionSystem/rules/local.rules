# CodeAlpha - Network Intrusion Detection System
# Snort 3 Custom Detection Rules
alert icmp any any -> any any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"DG WEEK3 SSH Traffic Detected"; flags:S; sid:1000002; rev:1;)
alert tcp any any -> $HOME_NET 80 (msg:"DG WEEK3 HTTP Traffic Detected"; flags:S; sid:1000003; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"DG WEEK3 Possible SYN Scan"; flags:S; flow:stateless; detection_filter:track by_src, count 10, seconds 5; sid:1000004; rev:1;)
